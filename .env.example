# Copy to .env and fill in. `make run` and `make run-azure` load it automatically;
# otherwise export the variables in your shell. Never commit the real .env.

# HMAC key for session tokens. Optional locally (a random key is used, so sessions end on
# restart); required, and identical on every instance, when running more than one.
# Generate one with: openssl rand -base64 48
CHAT_SESSION_SECRET=

# Where the local H2 database lives (default ./data).
# CHAT_DATA_DIR=./data

# --- Optional: PostgreSQL (activate with SPRING_PROFILES_ACTIVE=postgres) ---
# DATABASE_URL=jdbc:postgresql://localhost:5432/chat
# DATABASE_USERNAME=chat
# DATABASE_PASSWORD=chat

# --- Optional: Azure Web PubSub backplane (activate with SPRING_PROFILES_ACTIVE=azure) ---
# From the portal: Web PubSub resource > Keys > Connection string.
# AZURE_WEBPUBSUB_CONNECTION_STRING=Endpoint=https://<name>.webpubsub.azure.com;AccessKey=<key>;Version=1.0;
# Or use a managed identity / az login instead of a key:
# AZURE_WEBPUBSUB_ENDPOINT=https://<name>.webpubsub.azure.com
# AZURE_WEBPUBSUB_HUB=chat
# Extra browser origins allowed to open the WebSocket, comma-separated.
# CHAT_ALLOWED_ORIGINS=https://<app>.azurewebsites.net

# --- Terminal client ---
# CHAT_SERVER=http://localhost:8080
